# Copy this file to .env.local and fill in your own Supabase project's values.
# See README.md for how to find each of these in your Supabase dashboard.

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> Project API keys -> service_role (SECRET — server-only, never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# The public URL this site is deployed at (used for SEO metadata, sitemap, OG tags).
# Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "staging" ONLY on the staging deployment (Vercel -> Preview environment): shows a
# "test data only" banner on every page and hides the site from search engines.
# Leave it unset for the live site and for local development.
NEXT_PUBLIC_APP_ENV=

# Optional: enables automatic "payment confirmed" and "order shipped" emails to customers,
# sent via Gmail SMTP. Without these set, the app works exactly the same — it just skips
# sending emails. See README.md for how to generate an App Password.
GMAIL_USER=customdripchennai@gmail.com
GMAIL_APP_PASSWORD=

# Optional: display name customers see in their inbox (the address itself always matches
# GMAIL_USER — Gmail blocks sending from any other address). Defaults to "Custom Drip Chennai".
GMAIL_FROM_NAME=Custom Drip Chennai
