# Copy this file to .env.local and fill in your own Supabase project's values.
# See README.md for how to find each of these in your Supabase dashboard.

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> Project API keys -> service_role (SECRET — server-only, never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# The public URL this site is deployed at (used for SEO metadata, sitemap, OG tags).
# Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables automatic "payment confirmed" and "order shipped" emails to customers.
# Sign up free at https://resend.com (3,000 emails/month free), create an API key, and set it
# here. Without this set, the app works exactly the same — it just skips sending emails.
RESEND_API_KEY=

# Optional: defaults to Resend's shared onboarding@resend.dev sender if unset (works
# immediately, no setup, but low sending limits and looks unbranded). Once you verify your
# own domain in Resend, set this to something like:
# RESEND_FROM_EMAIL=Custom Drip Chennai <orders@customdripchennai.in>
RESEND_FROM_EMAIL=
